<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Home-screen widget -->
    <receiver
      android:name="expo.modules.nowplaying.NowPlayingWidgetProvider"
      android:exported="true"
      android:label="@string/np_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/now_playing_widget_info" />
    </receiver>
    <receiver
      android:name="expo.modules.nowplaying.WidgetActionReceiver"
      android:exported="false" />

    <!-- Android Auto: LocalTunes is a media app (the playback service is opened to Android
         Auto by plugins/withAndroidAuto.js). -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />
  </application>
</manifest>
